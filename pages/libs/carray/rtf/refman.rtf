00076 \} CARR;\par
00077 {\cf20 }\par
00078 {\cf20 /**}\par
00079 {\cf20  * @enum CARRError}\par
00080 {\cf20  * @brief Error codes returned by CARR operations.}\par
00081 {\cf20  */}\par
