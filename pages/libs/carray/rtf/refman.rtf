00038 {\cf20  */}\par
00039 {\cf17 typedef} {\cf17 struct }CARR\par
00040 \{{\cf20 }\par
00041 {\cf20     /**}\par
00042 {\cf20      * @brief Pointer to the array of stored element pointers.}\par
